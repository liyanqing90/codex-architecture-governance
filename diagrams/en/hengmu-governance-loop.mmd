flowchart LR
    subgraph context["Project context"]
        facts["Repository facts<br/>+ Profile"]
        brief["Approved<br/>Brief"]
        knowledge["Constraints + selected<br/>Knowledge"]
    end

    facts --> audit["Candidate<br/>assessment"]
    knowledge --> audit
    audit -->|"candidate findings"| verify["Independent<br/>verification"]
    verify --> review["Verified Review<br/>provenance bound"]

    facts --> target["Target architecture<br/>+ proposed Decision"]
    brief -->|"open / constrained"| target
    knowledge --> target
    review --> target
    target -->|"authorized"| accepted["Accepted<br/>Decision"]
    accepted --> plan["Implementation<br/>Plan"]
    plan --> gate["Deterministic<br/>quality gate"]
    review -.->|"finding policy"| gate
    gate --> outcome["Change / release<br/>decision"]

    classDef contextNode fill:#F4F2EC,stroke:#6D7078,color:#161719,stroke-width:1.5px;
    classDef reviewNode fill:#FFFFFF,stroke:#173FBE,color:#161719,stroke-width:2px;
    classDef actionNode fill:#173FBE,stroke:#173FBE,color:#FFFFFF,stroke-width:2px;
    classDef outcomeNode fill:#161719,stroke:#161719,color:#FFFFFF,stroke-width:2px;

    class facts,brief,knowledge contextNode;
    class audit,verify,review reviewNode;
    class target,accepted,plan,gate actionNode;
    class outcome outcomeNode;

    style context fill:#FFFFFF,stroke:#D9D9D2,stroke-width:1px
    linkStyle default stroke:#6D7078,stroke-width:1.5px
