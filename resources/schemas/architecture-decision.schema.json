{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/architecture-decision.schema.json",
  "title": "Architecture solution decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "problem", "knowledge_snapshot", "options", "selected_option", "rationale", "revisit_triggers"],
  "properties": {
    "schema_version": {
      "enum": ["1.1", "1.2"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_review", "source_review_sha256", "decided_at", "decision_makers", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
        },
        "source_review": {
          "type": "string",
          "minLength": 1
        },
        "source_review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_makers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": ["proposed", "accepted", "rejected", "superseded"]
        },
        "supersedes": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
        },
        "knowledge_selection_path": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_selection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality_attributes", "constraints", "finding_ids", "assumptions"],
      "properties": {
        "quality_attributes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "knowledge_snapshot": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "catalog_version", "sha256"],
            "properties": {
              "kind": {
                "enum": ["architecture-style", "pattern", "technology-profile"]
              },
              "catalog_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "sha256"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      }
    },
    "options": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "complexity_tier",
          "architecture_styles",
          "patterns",
          "technologies",
          "benefits",
          "liabilities",
          "assumptions",
          "quality_attribute_effects",
          "business_fit",
          "team_fit",
          "evolution_fit",
          "implementation_complexity",
          "operational_complexity",
          "migration_risk",
          "reversibility",
          "cost",
          "technical_maturity",
          "lock_in",
          "tradeoff_scores",
          "rejected_reasons"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "complexity_tier": {
            "enum": ["keep-current", "low", "medium", "high"]
          },
          "architecture_styles": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "patterns": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "technologies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "benefits": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 3}
          },
          "liabilities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 3}
          },
          "assumptions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "quality_attribute_effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attribute", "effect", "rationale"],
              "properties": {
                "attribute": {"type": "string", "minLength": 1},
                "effect": {"enum": ["improves", "neutral", "degrades", "unknown"]},
                "rationale": {"type": "string", "minLength": 3}
              }
            }
          },
          "implementation_complexity": {"enum": ["low", "medium", "high"]},
          "operational_complexity": {"enum": ["low", "medium", "high"]},
          "business_fit": {"type": "string", "minLength": 3},
          "team_fit": {"type": "string", "minLength": 3},
          "evolution_fit": {"type": "string", "minLength": 3},
          "migration_risk": {"enum": ["low", "medium", "high", "critical"]},
          "reversibility": {"enum": ["easy", "moderate", "difficult", "irreversible"]},
          "cost": {"enum": ["low", "medium", "high", "unknown"]},
          "technical_maturity": {
            "enum": ["experimental", "emerging", "stable", "mature", "unknown"]
          },
          "lock_in": {"enum": ["none", "low", "medium", "high", "unknown"]},
          "tradeoff_scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "business_fit",
              "quality_fit",
              "team_fit",
              "implementation",
              "operations",
              "migration",
              "reversibility",
              "cost",
              "maturity",
              "lock_in",
              "evolution"
            ],
            "properties": {
              "business_fit": {"type": "integer", "minimum": -2, "maximum": 2},
              "quality_fit": {"type": "integer", "minimum": -2, "maximum": 2},
              "team_fit": {"type": "integer", "minimum": -2, "maximum": 2},
              "implementation": {"type": "integer", "minimum": -2, "maximum": 2},
              "operations": {"type": "integer", "minimum": -2, "maximum": 2},
              "migration": {"type": "integer", "minimum": -2, "maximum": 2},
              "reversibility": {"type": "integer", "minimum": -2, "maximum": 2},
              "cost": {"type": "integer", "minimum": -2, "maximum": 2},
              "maturity": {"type": "integer", "minimum": -2, "maximum": 2},
              "lock_in": {"type": "integer", "minimum": -2, "maximum": 2},
              "evolution": {"type": "integer", "minimum": -2, "maximum": 2}
            }
          },
          "rejected_reasons": {
            "type": "array",
            "items": {"type": "string", "minLength": 3}
          }
        }
      }
    },
    "selected_option": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "rationale": {
      "type": "string",
      "minLength": 20
    },
    "revisit_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "hard_eliminations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "rule", "evidence"],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "rule": {"type": "string", "minLength": 3},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 3}
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slices", "rollback", "validation"],
      "properties": {
        "slices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "rollback": {
          "type": "string",
          "minLength": 3
        },
        "validation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        }
      },
      "then": {
        "required": ["migration"],
        "properties": {
          "decision": {
            "required": [
              "knowledge_selection_path",
              "knowledge_selection_sha256"
            ]
          },
          "problem": {
            "required": ["known_facts", "unknowns"]
          },
          "knowledge_snapshot": {
            "items": {
              "required": ["id", "version", "sha256"]
            }
          }
        }
      }
    }
  ]
}
