{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/architecture-design-brief.schema.json",
  "title": "Greenfield architecture design brief",
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "description"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": {"type": "string", "minLength": 8}
      }
    },
    "sshSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "identity", "namespace", "path"],
      "properties": {
        "format": {"const": "ssh"},
        "identity": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "architectureConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "disposition",
        "target",
        "scope",
        "authority",
        "rationale",
        "review_when"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,63}$"
        },
        "kind": {
          "enum": [
            "architecture-style",
            "pattern",
            "technology",
            "platform",
            "deployment",
            "data",
            "integration",
            "security",
            "compliance"
          ]
        },
        "disposition": {
          "enum": ["required", "preferred", "prohibited"]
        },
        "target": {
          "type": "string",
          "minLength": 3
        },
        "scope": {
          "type": "string",
          "minLength": 3
        },
        "authority": {
          "type": "string",
          "minLength": 3
        },
        "rationale": {
          "type": "string",
          "minLength": 8
        },
        "review_when": {
          "type": "string",
          "minLength": 3
        },
        "knowledge_id": {
          "type": "string",
          "minLength": 3
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["architecture-style", "pattern", "technology"]
              }
            },
            "required": ["kind"]
          },
          "then": {"required": ["knowledge_id"]}
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief",
    "context",
    "quality_scenarios",
    "boundaries",
    "critical_flows",
    "decision_questions",
    "success_criteria"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1"]
    },
    "design_mode": {
      "enum": ["open", "constrained"]
    },
    "architecture_constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/architectureConstraint"
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "created_at", "authors", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": ["draft", "approved", "superseded"]
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved_by",
            "approved_at",
            "authority",
            "evidence",
            "signatures"
          ],
          "properties": {
            "approved_by": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "approved_at": {"type": "string", "format": "date-time"},
            "authority": {"type": "string", "minLength": 3},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/fileEvidence"}
            },
            "signatures": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/sshSignature"}
            }
          }
        },
        "supersedes": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "users",
        "lifecycle",
        "constraints",
        "known_facts",
        "assumptions",
        "unknowns"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 20
        },
        "users": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "lifecycle": {
          "enum": ["prototype", "early", "growth", "scale", "mature"]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "known_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "quality_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "attribute",
          "priority",
          "source",
          "stimulus",
          "environment",
          "target",
          "response",
          "measure"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
          },
          "attribute": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "priority": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "source": {"type": "string", "minLength": 3},
          "stimulus": {"type": "string", "minLength": 3},
          "environment": {"type": "string", "minLength": 3},
          "target": {"type": "string", "minLength": 3},
          "response": {"type": "string", "minLength": 3},
          "measure": {"type": "string", "minLength": 3}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope",
        "external_systems",
        "data_owners",
        "trust_boundaries"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        },
        "out_of_scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 3}
        },
        "external_systems": {
          "type": "array",
          "items": {"type": "string", "minLength": 3}
        },
        "data_owners": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        },
        "trust_boundaries": {
          "type": "array",
          "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "critical_flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "steps", "failure_outcome", "recovery"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "trigger": {"type": "string", "minLength": 3},
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 3}
          },
          "failure_outcome": {"type": "string", "minLength": 3},
          "recovery": {"type": "string", "minLength": 3}
        }
      }
    },
    "decision_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "decision_owner"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
          },
          "question": {"type": "string", "minLength": 10},
          "decision_owner": {"type": "string", "minLength": 1},
          "deadline": {"type": "string", "format": "date"}
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "prohibited_options": {
      "type": "array",
      "items": {"type": "string", "minLength": 3}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.1"}
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["design_mode", "architecture_constraints"],
        "allOf": [
          {
            "if": {
              "properties": {
                "design_mode": {"const": "constrained"}
              },
              "required": ["design_mode"]
            },
            "then": {
              "properties": {
                "architecture_constraints": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "design_mode": {"const": "open"}
              },
              "required": ["design_mode"]
            },
            "then": {
              "properties": {
                "architecture_constraints": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.1"},
          "brief": {
            "properties": {"status": {"const": "approved"}},
            "required": ["status"]
          }
        },
        "required": ["schema_version", "brief"]
      },
      "then": {
        "properties": {
          "brief": {"required": ["approval"]}
        }
      }
    }
  ]
}
