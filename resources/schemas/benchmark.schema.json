{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/benchmark.schema.json",
  "title": "Architecture behavior benchmark corpus or result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "cases"],
  "properties": {
    "schema_version": {"enum": ["1.1", "1.2", "1.3"]},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "kind": {"enum": ["ground-truth", "run"]},
        "model": {"type": "string"},
        "surface": {"type": "string"},
        "skill_version": {"type": "string"},
        "run_at": {"type": "string", "format": "date-time"},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 20},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fixture", "expected_findings", "forbidden_recommendations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "fixture": {"type": "string", "minLength": 1},
          "skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "prompt": {"type": "string", "minLength": 20},
          "expected_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule_id", "present", "severity"],
              "properties": {
                "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{2,79}$"},
                "present": {"type": "boolean"},
                "severity": {"enum": ["critical", "high", "medium", "low", "info", "none"]}
              }
            }
          },
          "forbidden_recommendations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "expected_decision": {
            "$ref": "#/$defs/expectedDecision"
          },
          "observed_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule_id", "severity", "evidence", "evidence_valid"],
              "properties": {
                "rule_id": {"type": "string"},
                "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "line_start", "line_end", "excerpt"],
                    "properties": {
                      "path": {"type": "string", "minLength": 1},
                      "line_start": {"type": "integer", "minimum": 1},
                      "line_end": {"type": "integer", "minimum": 1},
                      "excerpt": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "evidence_valid": {"type": "boolean"}
              }
            }
          },
          "observed_recommendations": {
            "type": "array",
            "items": {"type": "string"}
          },
          "observed_decision": {
            "$ref": "#/$defs/observedDecision"
          },
          "trials": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/trial"}
          }
        }
      }
    }
  },
  "$defs": {
    "expectedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_option",
        "required_tradeoffs",
        "overdesign_options",
        "required_knowledge_ids",
        "minimum_rejected_options",
        "minimum_migration_slices"
      ],
      "properties": {
        "selected_option": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "acceptable_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required_tradeoffs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "overdesign_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required_knowledge_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "minimum_rejected_options": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_migration_slices": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "observedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_option",
        "compared_tradeoffs",
        "knowledge_ids",
        "rejected_options",
        "migration_slices"
      ],
      "properties": {
        "selected_option": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "compared_tradeoffs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "knowledge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "rejected_options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "reason": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "migration_slices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "observedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "evidence", "evidence_valid"],
      "properties": {
        "rule_id": {"type": "string"},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line_start", "line_end", "excerpt"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "excerpt": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence_valid": {"type": "boolean"}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "duration_seconds",
        "observed_findings",
        "observed_recommendations"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "minimum": 0},
        "observed_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/observedFinding"}
        },
        "observed_recommendations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "observed_decision": {
          "$ref": "#/$defs/observedDecision"
        },
        "execution": {
          "$ref": "#/$defs/trialExecution"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "cost_usd": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "trialExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "command_sha256",
        "stdout_sha256",
        "stderr_sha256",
        "observation_sha256",
        "log_record_sha256"
      ],
      "properties": {
        "exit_code": {"const": 0},
        "command_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "observation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "log_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "environment",
        "command_template_sha256",
        "inputs",
        "fixtures",
        "tools",
        "execution_log"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "dirty"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "dirty": {"type": "boolean"}
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "os_release",
            "architecture",
            "python_implementation",
            "python_version"
          ],
          "properties": {
            "os": {"type": "string", "minLength": 1},
            "os_release": {"type": "string", "minLength": 1},
            "architecture": {"type": "string", "minLength": 1},
            "python_implementation": {"type": "string", "minLength": 1},
            "python_version": {"type": "string", "minLength": 1}
          }
        },
        "command_template_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputs": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/provenanceInput"}
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "path", "sha256", "file_count"],
            "properties": {
              "case_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "file_count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "sha256"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "execution_log": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "format", "sha256", "records"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "format": {"const": "jsonl"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "records": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "provenanceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.3"},
          "benchmark": {
            "properties": {"kind": {"const": "run"}},
            "required": ["kind"]
          }
        },
        "required": ["schema_version", "benchmark"]
      },
      "then": {
        "properties": {
          "benchmark": {"required": ["provenance"]},
          "cases": {
            "items": {
              "required": ["trials"],
              "properties": {
                "trials": {
                  "items": {"required": ["execution"]}
                }
              }
            }
          }
        }
      }
    }
  ]
}
