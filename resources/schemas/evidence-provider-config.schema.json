{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/evidence-provider-config.schema.json",
  "title": "Project evidence provider execution configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "enabled",
          "command",
          "timeout_seconds",
          "success_exit_codes",
          "allow_without_detection",
          "environment_allowlist",
          "output_source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "enabled": {"type": "boolean"},
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "success_exit_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0, "maximum": 255}
          },
          "allow_without_detection": {"type": "boolean"},
          "environment_allowlist": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "output_source": {
            "enum": ["stdout", "stderr", "file"]
          },
          "result_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "output_source": {"const": "file"}
              },
              "required": ["output_source"]
            },
            "then": {
              "required": ["result_path"],
              "properties": {
                "result_path": {"const": "{evidence_output}"}
              }
            },
            "else": {
              "not": {"required": ["result_path"]}
            }
          }
        ]
      }
    }
  }
}
