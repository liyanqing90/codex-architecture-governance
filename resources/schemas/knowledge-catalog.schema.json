{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/knowledge-catalog.schema.json",
  "title": "Architecture knowledge catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "catalog_version", "entries"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "kind": {
      "enum": [
        "quality-model",
        "architecture-style",
        "pattern",
        "technology-profile",
        "reference-architecture",
        "migration",
        "domain-guidance",
        "decision-guide"
      ]
    },
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "intent", "fit_when", "avoid_when", "benefits", "liabilities", "sources", "freshness"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 2},
          "category": {"type": "string", "minLength": 1},
          "intent": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "fit_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "avoid_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "benefits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "liabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "warning_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "quality_attributes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "implementation_options": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "migration_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "alternatives": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "decision_rules": {"type": "array", "items": {"type": "string", "minLength": 3}},
          "operational_requirements": {"type": "array", "items": {"type": "string", "minLength": 3}},
          "lock_in": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "notes"],
            "properties": {
              "level": {"enum": ["none", "low", "medium", "high", "unknown"]},
              "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "url", "authority"],
              "properties": {
                "title": {"type": "string", "minLength": 2},
                "url": {"type": "string", "format": "uri"},
                "authority": {"enum": ["standard", "official", "maintainer", "research"]}
              }
            }
          },
          "freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewed_on", "review_after_days"],
            "properties": {
              "reviewed_on": {"type": "string", "format": "date"},
              "review_after_days": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
