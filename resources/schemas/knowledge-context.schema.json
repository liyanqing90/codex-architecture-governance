{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/knowledge-context.schema.json",
  "title": "Compact model-facing Knowledge context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_lock_sha256",
    "selection_result_sha256",
    "selected"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "selection_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selection_result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "priority",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "priority": {
            "enum": ["required", "recommended", "optional"]
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  }
}
