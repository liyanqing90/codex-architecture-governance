{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/knowledge-entry.schema.json",
  "title": "Markdown architecture knowledge entry frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "version",
    "status",
    "domains",
    "triggers",
    "quality_attributes",
    "related",
    "last_reviewed",
    "review_after_days",
    "source_policy",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(foundation|domain|decision|style|pattern|technology|reference|migration|anti-pattern|case-study)\\.[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "enum": [
        "foundation",
        "domain",
        "decision-guide",
        "architecture-style",
        "pattern",
        "technology-profile",
        "reference-architecture",
        "migration-guide",
        "anti-pattern",
        "case-study"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": ["draft", "active", "deprecated"]
    },
    "maturity": {
      "enum": ["standard", "golden"]
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reviewer", "reviewed_at"],
      "properties": {
        "method": {
          "enum": ["generated", "assisted-reviewed", "human-reviewed"]
        },
        "reviewer": {
          "type": "string",
          "minLength": 2
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "quality_attributes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*$"
      }
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(foundation|domain|decision|style|pattern|technology|reference|migration|anti-pattern|case-study)\\.[a-z0-9][a-z0-9-]*$"
      }
    },
    "legacy_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "review_after_days": {
      "type": "integer",
      "minimum": 1
    },
    "source_policy": {
      "enum": [
        "stable-principles",
        "stable-principles-plus-official-docs",
        "official-docs-required"
      ]
    },
    "dynamic_facts": {
      "type": "boolean"
    },
    "version_range": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "authority"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "authority": {
            "enum": ["standard", "official", "maintainer", "research"]
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9-]{1,31}$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "maturity": {
            "const": "golden"
          }
        },
        "required": ["maturity"]
      },
      "then": {
        "required": ["curation"],
        "properties": {
          "status": {
            "const": "active"
          },
          "curation": {
            "properties": {
              "method": {
                "enum": ["assisted-reviewed", "human-reviewed"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "technology-profile"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["dynamic_facts", "version_range"],
        "properties": {
          "source_policy": {
            "enum": [
              "stable-principles-plus-official-docs",
              "official-docs-required"
            ]
          }
        }
      }
    }
  ]
}
