{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/knowledge-selection.schema.json",
  "title": "Deterministic architecture knowledge selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection",
    "excluded",
    "inputs",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path", "sha256", "reasons"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "reason": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "task", "facts_sha256"],
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 3
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "facts_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_entries", "selected_entries"],
      "properties": {
        "maximum_entries": {
          "type": "integer",
          "minimum": 1
        },
        "selected_entries": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
