{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/portfolio.schema.json",
  "title": "Architecture portfolio registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "portfolio", "catalogs", "projects"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owners", "review_horizon_months", "review_output"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_horizon_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "review_output": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_capabilities", "technologies", "dependencies"],
      "properties": {
        "shared_capabilities": {
          "type": "string",
          "minLength": 1
        },
        "technologies": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "repository",
          "profile",
          "lifecycle",
          "owners",
          "capabilities",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "enum": ["experimental", "active", "maintenance", "retiring"]
          },
          "owners": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
