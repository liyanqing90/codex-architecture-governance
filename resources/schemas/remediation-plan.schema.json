{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/remediation-plan.schema.json",
  "title": "Architecture remediation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan", "items"],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1"]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_review",
        "generated_at",
        "scope",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "source_review": {
          "type": "string",
          "minLength": 1
        },
        "source_review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
        },
        "source_decision_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": ["draft", "accepted", "in-progress", "complete", "superseded"]
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "finding_ids",
          "desired_invariant",
          "owner",
          "recommended_option",
          "alternatives",
          "do_nothing",
          "effort",
          "change_risk",
          "governed_change",
          "dependencies",
          "sequence",
          "test_protection",
          "rollback",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
          },
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
            }
          },
          "desired_invariant": {
            "type": "string",
            "minLength": 10
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "recommended_option": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "rationale", "tradeoffs"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 3
              },
              "rationale": {
                "type": "string",
                "minLength": 10
              },
              "tradeoffs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "when_preferred", "tradeoffs"],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "when_preferred": {
                  "type": "string",
                  "minLength": 3
                },
                "tradeoffs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "do_nothing": {
            "type": "string",
            "minLength": 3
          },
          "effort": {
            "type": "object",
            "additionalProperties": false,
            "required": ["size", "uncertainty", "assumptions"],
            "properties": {
              "size": {
                "enum": ["xs", "s", "m", "l", "xl"]
              },
              "uncertainty": {
                "enum": ["low", "medium", "high"]
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "change_risk": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "governed_change": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sequence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "test_protection": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "rollback": {
            "type": "string",
            "minLength": 3
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "acceptance_evidence_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "test",
                "runtime",
                "contract",
                "security",
                "migration",
                "operational",
                "human"
              ]
            }
          },
          "completion_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "location",
                "sha256",
                "result",
                "observed_at"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "test",
                    "runtime",
                    "contract",
                    "security",
                    "migration",
                    "operational",
                    "human"
                  ]
                },
                "location": {"type": "string", "minLength": 1},
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "result": {"type": "string", "minLength": 3},
                "observed_at": {"type": "string", "format": "date-time"},
                "provider_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "run_id": {"type": "string", "minLength": 3}
              }
            }
          },
          "migration_type": {
            "enum": ["none", "code", "contract", "data", "infrastructure", "mixed"]
          },
          "data_compatibility": {
            "type": "string",
            "minLength": 3
          },
          "deployment_strategy": {
            "type": "string",
            "minLength": 3
          },
          "observability_changes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "stop_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.1"}
        }
      },
      "then": {
        "properties": {
          "plan": {
            "required": [
              "source_review_sha256",
              "source_decision",
              "source_decision_sha256"
            ]
          },
          "items": {
            "items": {
              "required": [
                "migration_type",
                "data_compatibility",
                "deployment_strategy",
                "observability_changes",
                "stop_conditions",
                "acceptance_evidence_types",
                "completion_evidence"
              ]
            }
          }
        }
      }
    }
  ]
}
