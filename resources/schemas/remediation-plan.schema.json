{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/remediation-plan.schema.json",
  "title": "Architecture remediation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan", "items"],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1", "1.2", "1.3"]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generated_at",
        "scope",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "source_review": {
          "type": "string",
          "minLength": 1
        },
        "source_review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_decision": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
        },
        "source_decision_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_context": {
          "type": "string",
          "minLength": 1
        },
        "source_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_kind": {
          "enum": ["remediation", "greenfield-implementation"]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": ["draft", "accepted", "in-progress", "complete", "superseded"]
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "desired_invariant",
          "owner",
          "recommended_option",
          "alternatives",
          "do_nothing",
          "effort",
          "change_risk",
          "governed_change",
          "dependencies",
          "sequence",
          "test_protection",
          "rollback",
          "acceptance_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
          },
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
            }
          },
          "finding_bindings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "fingerprint"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "target_bindings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runtime_units",
              "deployment_units",
              "data_owners",
              "interfaces",
              "trust_boundaries",
              "technologies",
              "critical_flows",
              "constraints"
            ],
            "properties": {
              "runtime_units": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "deployment_units": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "data_owners": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "interfaces": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "trust_boundaries": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "technologies": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^technology\\.[a-z0-9][a-z0-9._-]*$"
                }
              },
              "critical_flows": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "constraints": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9._-]{2,63}$"
                }
              }
            }
          },
          "knowledge_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "desired_invariant": {
            "type": "string",
            "minLength": 10
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "recommended_option": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "rationale", "tradeoffs"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 3
              },
              "rationale": {
                "type": "string",
                "minLength": 10
              },
              "tradeoffs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "when_preferred", "tradeoffs"],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "when_preferred": {
                  "type": "string",
                  "minLength": 3
                },
                "tradeoffs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "do_nothing": {
            "type": "string",
            "minLength": 3
          },
          "effort": {
            "type": "object",
            "additionalProperties": false,
            "required": ["size", "uncertainty", "assumptions"],
            "properties": {
              "size": {
                "enum": ["xs", "s", "m", "l", "xl"]
              },
              "uncertainty": {
                "enum": ["low", "medium", "high"]
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "change_risk": {
            "enum": ["low", "medium", "high", "critical"]
          },
          "governed_change": {
            "type": "boolean"
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sequence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "test_protection": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "rollback": {
            "type": "string",
            "minLength": 3
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "acceptance_evidence_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "test",
                "runtime",
                "contract",
                "security",
                "migration",
                "operational",
                "human"
              ]
            }
          },
          "completion_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "location",
                "sha256",
                "result",
                "observed_at"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "test",
                    "runtime",
                    "contract",
                    "security",
                    "migration",
                    "operational",
                    "human"
                  ]
                },
                "location": {"type": "string", "minLength": 1},
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "result": {"type": "string", "minLength": 3},
                "observed_at": {"type": "string", "format": "date-time"},
                "provider_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "run_id": {"type": "string", "minLength": 3}
              }
            }
          },
          "migration_type": {
            "enum": ["none", "code", "contract", "data", "infrastructure", "mixed"]
          },
          "data_compatibility": {
            "type": "string",
            "minLength": 3
          },
          "deployment_strategy": {
            "type": "string",
            "minLength": 3
          },
          "observability_changes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "stop_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.0"}
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "plan": {
            "required": ["source_review"]
          },
          "items": {
            "items": {
              "required": ["finding_ids"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"enum": ["1.1", "1.2"]}
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "plan": {
            "required": [
              "source_review",
              "source_review_sha256",
              "source_decision",
              "source_decision_sha256"
            ]
          },
          "items": {
            "items": {
              "required": [
                "finding_ids",
                "migration_type",
                "data_compatibility",
                "deployment_strategy",
                "observability_changes",
                "stop_conditions",
                "acceptance_evidence_types",
                "completion_evidence"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.2"}
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "finding_bindings",
                "knowledge_ids",
                "assumptions"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.3"}
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "plan": {
            "required": ["plan_kind"]
          },
          "items": {
            "items": {
              "required": [
                "migration_type",
                "data_compatibility",
                "deployment_strategy",
                "observability_changes",
                "stop_conditions",
                "acceptance_evidence_types",
                "completion_evidence"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.3"},
          "plan": {
            "properties": {
              "plan_kind": {"const": "remediation"}
            },
            "required": ["plan_kind"]
          }
        },
        "required": ["schema_version", "plan"]
      },
      "then": {
        "properties": {
          "plan": {
            "required": [
              "source_review",
              "source_review_sha256",
              "source_decision",
              "source_decision_sha256"
            ]
          },
          "items": {
            "items": {
              "required": ["finding_ids"],
              "properties": {
                "finding_ids": {
                  "minItems": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.3"},
          "plan": {
            "properties": {
              "plan_kind": {"const": "remediation"}
            },
            "required": ["plan_kind"]
          }
        },
        "required": ["schema_version", "plan"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "finding_bindings",
                "knowledge_ids",
                "assumptions"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.3"},
          "plan": {
            "properties": {
              "plan_kind": {"const": "greenfield-implementation"}
            },
            "required": ["plan_kind"]
          }
        },
        "required": ["schema_version", "plan"]
      },
      "then": {
        "properties": {
          "plan": {
            "required": [
              "source_context",
              "source_context_sha256",
              "source_decision",
              "source_decision_sha256"
            ]
          },
          "items": {
            "items": {
              "required": ["target_bindings"],
              "properties": {
                "finding_ids": false,
                "finding_bindings": false
              }
            }
          }
        }
      }
    }
  ]
}
