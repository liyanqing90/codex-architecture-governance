{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/repository-facts.schema.json",
  "title": "Deterministically inspected repository facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "languages",
    "frameworks",
    "storage",
    "interfaces",
    "infrastructure",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1"]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "commit", "dirty", "scanned_at", "scope"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^(unknown|[a-f0-9]{40,64})$"
        },
        "dirty": {
          "type": "boolean"
        },
        "scanned_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "frameworks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "storage": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "interfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "infrastructure": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifests", "migrations", "api_definitions", "ci", "deployments"],
      "properties": {
        "manifests": {
          "$ref": "#/$defs/paths"
        },
        "migrations": {
          "$ref": "#/$defs/paths"
        },
        "api_definitions": {
          "$ref": "#/$defs/paths"
        },
        "ci": {
          "$ref": "#/$defs/paths"
        },
        "deployments": {
          "$ref": "#/$defs/paths"
        }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+-]*$"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "role": {
          "enum": [
            "runtime",
            "production",
            "test",
            "benchmark-fixture",
            "example",
            "documentation",
            "generated",
            "vendor"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/paths"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "languages": {
            "items": {
              "required": ["id", "role", "evidence"]
            }
          },
          "frameworks": {
            "items": {
              "required": ["id", "role", "evidence"]
            }
          },
          "storage": {
            "items": {
              "required": ["id", "role", "evidence"]
            }
          },
          "interfaces": {
            "items": {
              "required": ["id", "role", "evidence"]
            }
          },
          "infrastructure": {
            "items": {
              "required": ["id", "role", "evidence"]
            }
          }
        }
      }
    }
  ]
}
