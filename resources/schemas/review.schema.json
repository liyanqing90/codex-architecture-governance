{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/review.schema.json",
  "title": "Architecture review bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review",
    "summary",
    "coverage",
    "findings",
    "evidence_sources",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "subject",
        "performed_at",
        "scope",
        "verification_state",
        "reviewers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "kind": {
          "enum": ["project", "ai-agent", "mobile", "portfolio"]
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "performed_at": {
          "type": "string",
          "format": "date-time"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "commits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_state": {
          "enum": ["candidates", "verified"]
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profile": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": ["commit"]
        },
        {
          "required": ["commits"]
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "raw_findings",
        "confirmed",
        "rejected",
        "needs_evidence"
      ],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "raw_findings": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "needs_evidence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "status", "finding_ids"],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{2,79}$"
          },
          "status": {
            "enum": ["assessed", "not_applicable", "not_assessed"]
          },
          "finding_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9._-]{2,63}$"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
