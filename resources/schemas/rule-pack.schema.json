{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/rule-pack.schema.json",
  "title": "Machine-readable architecture rule pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "review_kind", "rules"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "review_kind": {"enum": ["project", "ai-agent", "mobile", "portfolio"]},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "invariant", "evidence_requirements"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{2,79}$"},
          "domain": {"type": "string", "minLength": 1},
          "invariant": {"type": "string", "minLength": 10},
          "evidence_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 3}
          },
          "applies_when": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "quality_attributes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
