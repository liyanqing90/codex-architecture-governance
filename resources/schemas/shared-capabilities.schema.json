{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.architecture/schemas/shared-capabilities.schema.json",
  "title": "Portfolio shared capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "decision",
          "owner",
          "implementations",
          "consumers",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "shared",
              "intentional-duplication",
              "candidate-library",
              "candidate-service",
              "project-specific",
              "unknown"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "implementations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["project", "location"],
              "properties": {
                "project": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "consumers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
